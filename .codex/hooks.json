{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/tdd-guard.sh\"",
            "timeout": 30,
            "statusMessage": "Checking TDD guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/quality-gate.sh\"",
            "timeout": 600,
            "statusMessage": "Running quality gate"
          }
        ]
      }
    ]
  }
}
